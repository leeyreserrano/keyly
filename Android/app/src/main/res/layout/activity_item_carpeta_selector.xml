<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ItemsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo_keyly"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="270dp"
                app:srcCompat="@drawable/logo_keyly_sin_letras" />

            <ImageButton
                android:id="@+id/imgBtnLogOut"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/logout"
                android:scaleType="centerCrop"
                android:backgroundTint="@color/transparent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="@string/titolItemCarpetaSelector"
            android:textSize="25dp"
            android:textColor="@color/black"
            android:fontFamily="@font/airbnb_cereal_w_bd"/>

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">

            <LinearLayout
                android:id="@+id/items_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:elevation="8dp"
                android:background="@drawable/background_items_folder">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="20dp"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="15dp"
                    android:src="@drawable/key_violeta"
                    android:layout_gravity="center"
                    android:background="@drawable/background_items_folders_button"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:layout_marginStart="75dp"
                    android:layout_marginEnd="75dp"
                    android:text="@string/titolItems"
                    android:textSize="30dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/manrope_regular"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/carpetes_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:background="@drawable/background_items_folder">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="20dp"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="15dp"
                    android:src="@drawable/carpeta_violeta"
                    android:layout_gravity="center"
                    android:background="@drawable/background_items_folders_button"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:layout_gravity="center"
                    android:text="@string/titolCarpetes"
                    android:textSize="30dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/manrope_regular"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/menu_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemIconTint="#9046CF"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_app" />

</FrameLayout>
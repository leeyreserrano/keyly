<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".CarpetaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo_keyly"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="270dp"
                app:srcCompat="@drawable/logo_keyly_sin_letras" />

            <ImageView
                android:id="@+id/icon_notification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/icon_notification" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/nomCarpeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom carpeta"
                    android:textSize="25dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/airbnb_cereal_w_bd"/>

                <ImageButton
                    android:id="@+id/imgBtnStar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/star"
                    android:backgroundTint="@color/transparent"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center|right">

                <ImageButton
                    android:id="@+id/imgBtnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/editar"
                    android:backgroundTint="@color/transparent"/>

                <ImageButton
                    android:id="@+id/imgBtnEliminar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/delete"
                    android:backgroundTint="@color/transparent"/>

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/dataCreacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="10dp"
            android:text="Data creació:"
            android:textSize="15dp"
            android:textColor="@color/black"
            android:fontFamily="@font/manrope_regular"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/background_search"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/imgBtnFiltres"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/filtro_rayas"/>

                <EditText
                    android:id="@+id/aCTVCercarItems"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Cercar"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textColorHint="@color/dark_grey"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/lupa" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/imgBtnBack"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|left"
        android:layout_marginBottom="60dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/back"
        android:background="@drawable/background_button_circle_white"
        android:elevation="8dp"/>

    <ImageButton
        android:id="@+id/imgBtnAfegirItem"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="60dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/add"
        android:background="@drawable/background_button_circle_purple"
        android:elevation="8dp"/>

</FrameLayout>
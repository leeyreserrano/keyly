<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PerfilActivity"
    android:orientation="vertical"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/logo_keyly"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/logo_keyly_sin_letras"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/imgBtnAjuda"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ajuda"
                android:scaleType="centerCrop"
                android:backgroundTint="@color/transparent"/>

            <ImageButton
                android:id="@+id/imgBtnIdioma"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/idioma"
                android:scaleType="centerCrop"
                android:backgroundTint="@color/transparent"/>

            <ImageButton
                android:id="@+id/imgBtnLogOut"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/logout"
                android:scaleType="centerCrop"
                android:backgroundTint="@color/transparent"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/imgVPerfil"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:src="@drawable/foto_perfil"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"/>

                <ImageButton
                    android:id="@+id/imgBtnAddImg"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="5dp"
                    android:padding="10dp"
                    android:elevation="5dp"
                    android:src="@drawable/add_foto_perfil"
                    android:scaleType="fitCenter"
                    android:background="@drawable/background_button_circle_purple"
                    android:layout_gravity="bottom|right"
                    android:visibility="visible"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="20dp"
                android:background="@drawable/background_layout_settings"
                android:elevation="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/imgBtnEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|top"
                        android:backgroundTint="@color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/editar"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/ll_nom_item"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="1dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtNomUsuari"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/airbnb_cereal_w_bd"
                                    android:text="@string/hintNomUsuari"
                                    android:textColor="@color/black"
                                    android:textSize="20dp"
                                    android:visibility="visible"/>

                                <TextView
                                    android:id="@+id/txtRolInternUsuari"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/airbnb_cereal_w_bd"
                                    android:text="Rol intern"
                                    android:textColor="@color/black"
                                    android:textSize="15dp"
                                    android:visibility="visible"/>

                                <EditText
                                    android:id="@+id/etNomUsuari"
                                    android:layout_width="match_parent"
                                    android:layout_height="35dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:layout_marginBottom="5dp"
                                    android:background="@drawable/background_text_notes"
                                    android:hint="@string/hintNomUsuari"
                                    android:paddingStart="12dp"
                                    android:visibility="gone" />

                                <FrameLayout
                                    android:id="@+id/flRolIntern"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginBottom="5dp"
                                    android:visibility="gone">

                                    <Spinner
                                        android:id="@+id/spRolIntern"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/background_layout_gestions"
                                        android:padding="5dp"/>

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center_vertical|end"
                                        android:layout_marginEnd="10dp"
                                        android:src="@drawable/back"
                                        android:rotation="270"
                                        android:clickable="false"
                                        android:focusable="false"/>

                                </FrameLayout>

                                <CheckBox
                                    android:id="@+id/cbAdministrar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cbAdministrar"
                                    android:checked="false"
                                    android:buttonTint="@color/purple_button"
                                    android:visibility="gone"/>

                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/imgBtnEditarUsuari"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/editar"
                                android:backgroundTint="@color/transparent"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtCorreu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_regular"
                                android:text="Correu:"
                                android:textColor="@color/light_grey"
                                android:textSize="15dp"
                                android:visibility="gone" />

                            <EditText
                                android:id="@+id/etCorreu"
                                android:layout_width="match_parent"
                                android:layout_height="35dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/background_text_notes"
                                android:hint="@string/hintCorreu"
                                android:paddingStart="12dp"
                                android:visibility="visible" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:divider="?android:attr/listDivider"
                            android:orientation="horizontal"
                            android:showDividers="middle">

                            <LinearLayout
                                android:id="@+id/llSucursal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <TextView
                                    android:id="@+id/txtSucursal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/manrope_regular"
                                    android:text="Sucursal"
                                    android:textColor="@color/light_grey"
                                    android:textSize="15dp"
                                    android:visibility="gone" />

                                <FrameLayout
                                    android:id="@+id/flSucursal"
                                    android:layout_width="115dp"
                                    android:layout_height="wrap_content">

                                    <Spinner
                                        android:id="@+id/spSucursal"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:background="@drawable/background_layout_gestions"
                                        android:padding="5dp"/>

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center_vertical|end"
                                        android:layout_marginEnd="10dp"
                                        android:src="@drawable/back"
                                        android:rotation="270"
                                        android:clickable="false"
                                        android:focusable="false"/>

                                </FrameLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llDepartament"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <TextView
                                    android:id="@+id/txtDepartament"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/manrope_regular"
                                    android:text="Departament"
                                    android:textColor="@color/light_grey"
                                    android:textSize="15dp"
                                    android:visibility="gone" />

                                <FrameLayout
                                    android:id="@+id/flDepartament"
                                    android:layout_width="115dp"
                                    android:layout_height="wrap_content">

                                    <Spinner
                                        android:id="@+id/spDepartament"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:background="@drawable/background_layout_gestions"
                                        android:padding="5dp"/>

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center_vertical|end"
                                        android:layout_marginEnd="10dp"
                                        android:src="@drawable/back"
                                        android:rotation="270"
                                        android:clickable="false"
                                        android:focusable="false"/>

                                </FrameLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llRol"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <TextView
                                    android:id="@+id/txtRol"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/manrope_regular"
                                    android:text="Rol"
                                    android:textColor="@color/light_grey"
                                    android:textSize="15dp"
                                    android:visibility="gone" />

                                <FrameLayout
                                    android:id="@+id/flRol"
                                    android:layout_width="115dp"
                                    android:layout_height="wrap_content">

                                    <Spinner
                                        android:id="@+id/spRol"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:background="@drawable/background_layout_gestions"
                                        android:padding="5dp"/>

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center_vertical|end"
                                        android:layout_marginEnd="10dp"
                                        android:src="@drawable/back"
                                        android:rotation="270"
                                        android:clickable="false"
                                        android:focusable="false"/>

                                </FrameLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#f3f3f3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/background_dialog"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/airbnb_cereal_w_bd"
                        android:text="@string/hintContrasenya"
                        android:textColor="@color/black"
                        android:textSize="20dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/ll_password"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/backgroung_edit_text_password"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etClauMestra"
                                android:layout_width="1dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:background="@color/transparent"
                                android:enabled="false"
                                android:hint="@string/hintContrasenya"
                                android:inputType="textPassword"
                                android:paddingStart="15dp"
                                android:textColor="@color/not_enabled" />

                            <LinearLayout
                                android:id="@+id/llActions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="right|center"
                                android:orientation="horizontal"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/imgBtnCopy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:backgroundTint="@color/transparent"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/copy" />

                                <ImageButton
                                    android:id="@+id/imgBtnEye"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:backgroundTint="@color/transparent"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/visibility" />

                            </LinearLayout>

                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/imgBtnGenerate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:backgroundTint="@color/transparent"
                            android:scaleType="fitXY"
                            android:src="@drawable/generate_password"
                            android:visibility="gone" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnModificarGuardarContra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/background_button_purple"
                        android:fontFamily="@font/airbnb_cereal_w_bd"
                        android:text="Modificar"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:visibility="gone"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnCancelarPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/background_button_purple"
                        android:fontFamily="@font/airbnb_cereal_w_bd"
                        android:text="@string/btnCancelar"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:visibility="gone"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llGestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/background_dialog"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llGestioUsuaris"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_layout_gestions"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="1dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llGestioUsuaris"
                            android:textColor="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/transparent"
                            android:rotation="180"
                            android:src="@drawable/back" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGestioSucursals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_layout_gestions"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="1dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llGestioSucursals"
                            android:textColor="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/transparent"
                            android:rotation="180"
                            android:src="@drawable/back" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGestioDepartaments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_layout_gestions"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="1dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llGestioDepartaments"
                            android:textColor="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/transparent"
                            android:rotation="180"
                            android:src="@drawable/back" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGestioRols"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_layout_gestions"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="1dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llGestioRols"
                            android:textColor="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/transparent"
                            android:rotation="180"
                            android:src="@drawable/back" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGestioDominis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_layout_gestions"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="1dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llGestioDominis"
                            android:textColor="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/transparent"
                            android:rotation="180"
                            android:src="@drawable/back" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llInformes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_layout_gestions"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="1dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llInformes"
                            android:textColor="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/transparent"
                            android:rotation="180"
                            android:src="@drawable/back" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTempsExpItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/background_dialog"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/airbnb_cereal_w_bd"
                            android:text="@string/llTempsExpItems"
                            android:textColor="@color/black" />

                        <Spinner
                            android:id="@+id/spTempsExpItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/background_layout_gestions"
                            android:padding="5dp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/imgBtnGuardarTempsExpItems"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="10dp"
                        android:backgroundTint="@color/transparent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/check" />

                </LinearLayout>


                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/background_button_purple"
                    android:fontFamily="@font/airbnb_cereal_w_bd"
                    android:text="@string/btnGuardar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:visibility="visible"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnCancelar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/background_button_normal"
                    android:fontFamily="@font/airbnb_cereal_w_bd"
                    android:text="@string/btnCancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEliminar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/background_button_eliminar"
                    android:fontFamily="@font/airbnb_cereal_w_bd"
                    android:text="@string/btnEliminar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:visibility="visible"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/menu_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemIconTint="#9046CF"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_app"
        android:elevation="8dp"
        android:visibility="visible"/>

</LinearLayout>
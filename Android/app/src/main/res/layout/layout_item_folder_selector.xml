<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="17dp"
    android:paddingBottom="17dp"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/background_dialog">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/llItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:elevation="8dp"
            android:background="@drawable/background_items_folder">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:padding="20dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="15dp"
                android:src="@drawable/key"
                android:layout_gravity="center"
                android:background="@drawable/background_items_folders_button"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:layout_marginStart="75dp"
                android:layout_marginEnd="75dp"
                android:text="Items"
                android:textSize="30dp"
                android:textColor="@color/black"
                android:fontFamily="@font/manrope_regular"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCarpeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:background="@drawable/background_items_folder">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:padding="20dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="15dp"
                android:src="@drawable/carpeta"
                android:layout_gravity="center"
                android:background="@drawable/background_items_folders_button"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:layout_gravity="center"
                android:text="Carpeta"
                android:textSize="30dp"
                android:textColor="@color/black"
                android:fontFamily="@font/manrope_regular"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnCancelarCarpeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="Cancelar"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            android:background="@drawable/background_button_normal"/>

    </LinearLayout>

</LinearLayout>
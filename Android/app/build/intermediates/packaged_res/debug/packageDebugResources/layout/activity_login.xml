<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="387dp"
        android:background="@drawable/section_logo_login">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/imgBtnAjuda"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ajuda"
                    android:scaleType="centerCrop"
                    android:backgroundTint="@color/transparent"/>

                <ImageButton
                    android:id="@+id/imgBtnIdioma"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/idioma"
                    android:scaleType="centerCrop"
                    android:backgroundTint="@color/transparent"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="388dp"
            app:srcCompat="@drawable/logo_keyly" />
    </FrameLayout>

    <EditText
        android:id="@+id/txtUsuari"
        android:layout_width="352dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100px"
        android:padding="30px"
        android:background="@drawable/edit_text_enabled"
        android:hint="@string/hintCorreu"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/txtContrasenya"
        android:layout_width="352dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50px"
        android:padding="30px"
        android:background="@drawable/edit_text_enabled"
        android:hint="@string/hintContrasenya"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="352dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50px"
        android:text="@string/btnLogin"
        android:textColor="@color/white"
        android:textSize="17dp"
        android:fontFamily="@font/airbnb_cereal_w_bd"
        android:textAllCaps="false"
        android:background="@drawable/background_button_purple"
        app:backgroundTint="@null" />
</LinearLayout>